{
  "name": "codeatlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "benchmark:contracts": "pnpm --filter @codeatlas/benchmark benchmark:contracts",
    "benchmark:analyzer": "pnpm --filter @codeatlas/benchmark benchmark:analyzer",
    "benchmark:realworld:materialize": "pnpm --filter @codeatlas/benchmark benchmark:realworld:materialize",
    "benchmark:realworld": "pnpm --filter @codeatlas/benchmark benchmark:realworld",
    "codeatlas": "tsx packages/analyzer/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.10"
  }
}
